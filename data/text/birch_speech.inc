gText_Birch_Welcome::
	.string "{JPN}やあ! またせて すまないね!\p"
	.string "ポケットモンスターの せかいへ ようこそ!\p"
	.string "わたしの なまえは オダマキ。\p"
	.string "みんなからは ポケモン はかせと\n"
	.string "よばれているよ。\p"
	.string "$"

gText_Birch_Pokemon::
	.string "{JPN}これが 「ポケモン」と よばれる いきものだ。\p"
	.string "\n"
	.string "$"

gText_Birch_MainSpeech::
	.string "{JPN}この せかいには ポケモンと よばれる\n"
	.string "いきものたちが いたるところに すんでいる。\p"
	.string "わたしたち にんげんは ポケモンと\n"
	.string "ときには なかよしの あそびあいてとして\l"
	.string "ときには ちからを あわせる なかまとして\p"
	.string "そして ときには ポケモンと ともに\n"
	.string "ほかの ひとたちと たたかいながら くらしている。\p"
	.string "でも これほど みぢかなのに わたしたちは\n"
	.string "ポケモンの すべてを しっている わけじゃない。\p"
	.string "じつは ポケモンには まだまだ\n"
	.string "たくさんの なぞが あるんだ。\p"
	.string "その なぞを ときあかすために\n"
	.string "わたしは けんきゅうを つづけている。\l"
	.string "それが わたしの しごとさ。\p"
	.string "$"

gText_Birch_AndYouAre::
	.string "{JPN}それで きみは?$"

gText_Birch_BoyOrGirl::
	.string "{JPN}きみは おとこのこ?\n"
	.string "それとも おんなのこ?$"

gText_Birch_WhatsYourName::
	.string "{JPN}よし。\n"
	.string "きみの なまえを おしえてくれるかい?$"

gText_Birch_SoItsPlayer::
	.string "{JPN}{ENG}{PLAYER}{JPN}{ENG}{KUN}{JPN} で いいんだね?$"

gText_Birch_YourePlayer::
	.string "{JPN}ああ そうか!\p"
	.string "{ENG}{PLAYER}{JPN}{ENG}{KUN}{JPN}は わたしの ふるさと\n"
	.string "ミシロタウンに ひっこしてくる こだね。\l"
	.string "やっと わかったよ!\p"
	.string "$"

gText_Birch_AreYouReady::
	.string "{JPN}よし じゅんびは いいかい?\p"
	.string "いよいよ きみだけの ぼうけんが\n"
	.string "はじまる!\p"
	.string "ゆめと ぼうけんと ともだちが まつ\n"
	.string "ポケモンの せかいへ\l"
	.string "ゆうきを だして とびこもう!\p"
	.string "では あとで まっているよ。\n"
	.string "わたしの けんきゅうじょに きてくれ。\p"
	.string "$"
