	end

Route4_Text_TrippedOverGeodude::
	.string "{JPN}いてっ! いわの ポケモン\n"
	.string "イシツブテに つまずいちゃった!$"

Route4_Text_CrissyIntro::
	.string "{JPN}キノコの ポケモンを さがしに\n"
	.string "おつきみやまに きたの。$"

Route4_Text_CrissyDefeat::
	.string "{JPN}せっかく つかまえたのに!$"

Route4_Text_CrissyPostBattle::
	.string "{JPN}ここには もう キノコは\n"
	.string "ないかもしれない。\p"
	.string "ぜんぶ つかまえちゃったと おもうわ。$"

Route4_Text_MtMoonEntrance::
	.string "{JPN}おつきみやま\n"
	.string "トンネル いりぐち$"

Route4_Text_RouteSign::
	.string "{JPN}ここは 4ばんどうろ\n"
	.string "おつきみやま - ハナダシティ$"

Text_MegaPunchTeach::
	.string "{JPN}うなりを あげる もうれつな パンチ!\p"
	.string "はかいりょく ばつぐん!\p"
	.string "いざという ときには\n"
	.string "メガトンパンチこそ さいきょうの こうげき!\l"
	.string "そう おもうだろう?\p"
	.string "さあ!\n"
	.string "きみの ポケモンに おしえてやろう!$"

Text_MegaPunchDeclined::
	.string "{JPN}メガトンパンチの ねうちが わかったら\n"
	.string "また くるが いい。$"

Text_MegaPunchWhichMon::
	.string "{JPN}よし!\n"
	.string "どの ポケモンに おぼえさせる?$"

Text_MegaPunchTaught::
	.string "{JPN}これで われらは パンチの みちを\n"
	.string "ゆく どうしだ!\p"
	.string "むこうで くだらない キックばかり\n"
	.string "きたえている おろかものに\l"
	.string "みつかる まえに たちさるが いい。$"

Text_MegaKickTeach::
	.string "{JPN}ざんこくな までに もうれつな キック!\p"
	.string "はかいりょく ばつぐん!\p"
	.string "つまるところ\n"
	.string "メガトンキックこそ さいきょうの こうげき!\l"
	.string "そう おもわないか?\p"
	.string "よし!\n"
	.string "きみの ポケモンに おしえてやる!$"

Text_MegaKickDeclined::
	.string "{JPN}メガトンキックの ねうちに きづけば\n"
	.string "はってでも もどってくるだろう。$"

Text_MegaKickWhichMon::
	.string "{JPN}いいだろう!\n"
	.string "どの ポケモンが おぼえたい?$"

Text_MegaKickTaught::
	.string "{JPN}これで われらは キックの みちを\n"
	.string "ゆく こころの とも だ!\p"
	.string "むこうで たんじゅんな パンチばかり\n"
	.string "きたえている おおばかものに\l"
	.string "みつかる まえに にげるが いい。$"

Route4_Text_PeopleLikeAndRespectBrock::
	.string "{JPN}わあ それって グレーバッジ!\n"
	.string "タケシから もらったんでしょ?\p"
	.string "タケシは かっこいい。 つよいだけじゃない。\n"
	.string "みんなに したわれて そんけい されてる。\p"
	.string "ぼくも タケシみたいな\n"
	.string "ジムリーダーに なりたいな。$"
