Text_SeismicTossTeach::
	.string "{JPN}うちゅうの ひみつ…\n"
	.string "ちきゅうの なぞ…\p"
	.string "わたしたちが ほとんど しらない\n"
	.string "ことは たくさん ある。\p"
	.string "だからこそ なげださずに\n"
	.string "もっと べんきょう しなくては。\p"
	.string "なげて いいのは…\p"
	.string "そう ちきゅうなげ なんて どうだね?\n"
	.string "ポケモンに おしえて あげようか?$"

Text_SeismicTossDeclined::
	.string "{JPN}そうかね?\n"
	.string "きっと また くるだろう。$"

Text_SeismicTossWhichMon::
	.string "{JPN}どの ポケモンに\n"
	.string "ちきゅうなげを おしえる?$"

Text_SeismicTossTaught::
	.string "{JPN}なげださずに がんばるんだよ。\n"
	.string "その ちょうしで。$"

PewterCity_Museum_1F_Text_WhatsSpecialAboutMoonStone::
