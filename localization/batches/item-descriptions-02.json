    }
  },
  {
    "id": "332e4846d251cb9b",
    "translation": "{JPN}あたたかいココアのすいとう\\n。ゆきにかこまれたしまいの\\nこうぶつ。{ENG}",
    "target": "item_description",
    "provenance": {
      "method": "English description translated; macros protected",
      "columns": 13,
      "max_lines": 3
    }
  },
  {
    "id": "f08474deed9334c4",
    "translation": "{JPN}つよいくすりのこびん。アッ\\nシュランドのしにかけたおと\\nこにひつよう。{ENG}",
    "target": "item_description",
    "provenance": {
      "method": "English description translated; macros protected",
      "columns": 13,
      "max_lines": 3
    }
  },
  {
    "id": "eb1f8a97b91fbf07",
    "translation": "{JPN}さわるとあたたかいびん。け\\nっしてさめずふたもあかない\\n。{ENG}",
    "target": "item_description",
    "provenance": {
      "method": "English description translated; macros protected",
      "columns": 13,
      "max_lines": 3
    }
  },
  {
    "id": "ef0353ae120f80ae",
    "translation": "{JPN}だれかのものだったじかん。\\nみためよりおもい。{ENG}",
    "target": "item_description",
    "provenance": {
      "method": "English description translated; macros protected",
      "columns": 13,
      "max_lines": 3
    }
  },
  {
    "id": "c0d82c52c25afb12",
    "translation": "{JPN}だれもいえなかったさよなら\\n。もつとかすかにうなる。{ENG}",
    "target": "item_description",
    "provenance": {
      "method": "English description translated; macros protected",
      "columns": 13,
      "max_lines": 3
    }
  },
  {
    "id": "48cb6f442138eff6",
    "translation": "{JPN}もちぬしのかおさえのこって\\nいないなまえ。おもいだせそ\\nうなのに。{ENG}",
    "target": "item_description",
    "provenance": {
      "method": "English description translated; macros protected",
      "columns": 13,
      "max_lines": 3
    }
  },
  {
    "id": "f78104e4cb7ab2f1",
    "translation": "{JPN}なんどもおりたたまれもうに\\nどとひらけなくなったてがみ\\n。{ENG}",
