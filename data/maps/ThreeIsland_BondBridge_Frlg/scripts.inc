	.string "{JPN}ポケモンに みずぎを\n"
	.string "かみやぶられちゃったの\p"
	.string "みずから でられないの!$"

ThreeIsland_BondBridge_Text_JoyIntro::
	.string "{JPN}ジョイ: わたしたちの すきな\n"
	.string "ポケモンを おしえて あげる!$"

ThreeIsland_BondBridge_Text_JoyDefeat::
	.string "{JPN}ジョイ: ああ…\n"
	.string "メグ!$"

ThreeIsland_BondBridge_Text_JoyPostBattle::
	.string "{JPN}ジョイ: たのしかったね!\n"
	.string "また バトル しようね!$"

ThreeIsland_BondBridge_Text_JoyNotEnoughMons::
	.string "{JPN}ジョイ: メグと いっしょに\n"
	.string "たたかいたいの\p"
	.string "ポケモン 1ぴきじゃ たりないわ$"

ThreeIsland_BondBridge_Text_MegIntro::
	.string "{JPN}メグ: わたしたちの すきな\n"
	.string "ポケモンを みせて あげる$"

ThreeIsland_BondBridge_Text_MegDefeat::
	.string "{JPN}メグ: ああ…\n"
	.string "ジョイ!$"

ThreeIsland_BondBridge_Text_MegPostBattle::
	.string "{JPN}メグ: ジョイ たのしかったね?$"

ThreeIsland_BondBridge_Text_MegNotEnoughMons::
