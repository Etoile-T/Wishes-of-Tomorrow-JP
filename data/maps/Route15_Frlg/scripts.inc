	.string "ポケモンの こうかん!$"

Route15_Text_CeliaDefeat::
	.string "{JPN}こうかんって いったでしょ!$"

Route15_Text_CeliaPostBattle::
	.string "{JPN}ともだちと しょっちゅう\n"
	.string "ポケモンを こうかん してるの$"

Route15_Text_YazminIntro::
