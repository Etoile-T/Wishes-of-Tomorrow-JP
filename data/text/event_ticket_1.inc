EventTicket_Text_ShowOldSeaMap:
	.string "{JPN}カイナシティ ゆきの ふねは…\p"
	.string "はい? なんと おっしゃいました?\n"
	.string "この ちずの ばしょへ ふねで いけるか?\p"
	.string "もっと くわしい ものが おりますので\n"
	.string "しょうしょう おまちください。$"

EventTicket_Text_ThatPass:
	.string "{JPN}カイナシティ ゆきの ふねは…\p"
	.string "おや?\n"
	.string "その パスは…$"

EventTicket_Text_ShowEonTicket:
	.string "{JPN}よう あんたかい あの みょうちきりんな\n"
	.string "パスを もってきたのは?\p"
	.string "いいかい あんたが いこうと してるのは\n"
	.string "はるか みなみの ちっぽけな しまだ。\p"
	.string "むこうに ついたら なにに でくわすか\n"
	.string "わかったもんじゃねえ。\l"
	.string "こいつは ぶるっちまうぜ!\p"
	.string "さあ しゅっこうだ!$"

EventTicket_Text_SouthernIslandSailBack:
	.string "{JPN}よう この ぱっとしない しまにゃ\n"
	.string "みるものも やることも なんにもねえ。\p"
	.string "ミナモに もどるとしようや?$"

EventTicket_Text_SailHome:
	.string "{JPN}よし わかった!\n"
	.string "かえるとするか!$"

EventTicket_Text_AsYouLike:
	.string "{JPN}おう すきに するがいいさ。$"

SouthernIsland_Interior_Text_Sign:
	.string "{JPN}「すべての ゆめは もうひとつの げんじつ。\n"
	.string "わすれる なかれ…」$"

SouthernIsland_Exterior_Text_Sign:
	.string "{JPN}「きおくが うすれゆく ものは\n"
