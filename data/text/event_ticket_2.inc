EventTicket_Text_OldSeaMapTooFar:
	.string "{JPN}どうした わかいの?\p"
	.string "なに? ぼろぼろの ふるい ちずを\n"
	.string "もっているって いうのは あんたかい?\p"
	.string "どれ みせてみな。\n"
	.string "… … … … … …\p"
	.string "うーん こいつは ずいぶん とおいな。\n"
	.string "わるいが ちからに なれそうに ないよ…$"

EventTicket_Text_BrineyHoldOnASecond:
	.string "{JPN}ハギ: ちょっと まった!\p"
	.string "わしが さんざん せわに なった ひとを\n"
	.string "ことわるとは どういう ことじゃ!$"

EventTicket_Text_BrineyLetsSail:
	.string "{JPN}{ENG}{PLAYER}{JPN}{ENG}{KUN}{JPN} ほんとうに すまなかった。\p"
	.string "せっかく たよって きてくれたのに\n"
	.string "おいかえす ところじゃった。\p"
	.string "つぐないを させてくれ。\p"
	.string "もちろん すぐに しゅっこうじゃ!\p"
	.string "この ふるびたかいずに のっている\n"
	.string "しまを さがしに いこう!$"

EventTicket_Text_OddTicketGetOnBoard:
	.string "{JPN}あの ふしぎな チケットを もってきたのは\n"
	.string "あんたかい?\p"
	.string "あんたが いこうと している ところは\n"
	.string "はるか とおくに ある しまだ。\p"
	.string "そこに なにが まっているのか だれも しらない…\p"
	.string "かんがえただけで ふなのりの\n"
	.string "ちが さわぐぜ!\p"
	.string "さあ のりな わかいの!$"

