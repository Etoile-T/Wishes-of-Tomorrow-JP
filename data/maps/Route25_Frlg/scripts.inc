Route25_Frlg_MapScripts::
	.byte 0

Route25_EventScript_SeaCottageSign::
	msgbox Route25_Text_SeaCottageSign, MSGBOX_SIGN
	end

Route25_EventScript_Man::
	msgbox Route25_Text_AreYouHereAlone, MSGBOX_NPC
	end

Route25_Text_JoeyIntro::
	.string "{JPN}ここには ちもとの トレーナーが\n"
	.string "れんしゅうしに くるんだ。$"

Route25_Text_JoeyDefeat::
	.string "{JPN}なかなか やるね。$"

Route25_Text_JoeyPostBattle::
	.string "{JPN}どんな ポケモンにも じゃくてんが ある。\n"
	.string "いちばん つよい ポケモンでもね。\p"
	.string "だから いろんな タイプの ポケモンを\n"
	.string "そだてるのが いちばん なんだ。$"

Route25_Text_DanIntro::
	.string "{JPN}パパに クチバシティの サント・アンヌごうの\n"
	.string "すてきな パーティに つれてって もらったんだ。$"

Route25_Text_DanDefeat::
	.string "{JPN}おこってないもん!$"

Route25_Text_DanPostBattle::
	.string "{JPN}サント・アンヌごうでは せかいじゅうの\n"
	.string "トレーナーを みかけたよ。$"

Route25_Text_FlintIntro::
	.string "{JPN}おれは イケてる おとこ。\n"
	.string "かのじょだって いるんだぜ!$"

Route25_Text_FlintDefeat::
	.string "{JPN}ちぇっ くそー……$"

Route25_Text_FlintPostBattle::
	.string "{JPN}ま いいさ。\n"
	.string "かのじょが なぐさめて くれるから。$"

Route25_Text_KelseyIntro::
	.string "{JPN}はーい!\n"
	.string "わたしの かれし イケてるのよ!$"

Route25_Text_KelseyDefeat::
	.string "{JPN}ちょうしが いまいち だったわ……$"

Route25_Text_KelseyPostBattle::
	.string "{JPN}かれしも あなたくらい\n"
	.string "つよかったら いいのに。$"

Route25_Text_ChadIntro::
	.string "{JPN}なんだか よかんが したんだ……\n"
	.string "きみと たたかう ことに なるって!$"

Route25_Text_ChadDefeat::
	.string "{JPN}まけることも わかってたよ!$"

Route25_Text_ChadPostBattle::
	.string "{JPN}ポケモンが こんらん したら\n"
	.string "いれかえると いい。\p"
	.string "それが いい さくせんだよ。$"

Route25_Text_HaleyIntro::
	.string "{JPN}ともだちが かわいい ポケモンを\n"
	.string "たくさん もってるの。 うらやましい!$"

Route25_Text_HaleyDefeat::
	.string "{JPN}もう うらやましくない!$"

Route25_Text_HaleyPostBattle::
	.string "{JPN}おつきみやまから きたの?\n"
	.string "ピッピ くれない?$"

Route25_Text_FranklinIntro::
	.string "{JPN}おつきみやまから おりてきた ばかりだけど\n"
	.string "まだまだ たいりょくは のこってるぞ!$"

Route25_Text_FranklinDefeat::
	.string "{JPN}よく がんばったな!$"

Route25_Text_FranklinPostBattle::
	.string "{JPN}ちくしょう!\n"
	.string "あの どうくつで ズバットに かまれた。$"

Route25_Text_NobIntro::
	.string "{JPN}みさきの ポケモンマニアの\n"
	.string "コレクションを みに いくんだ。$"

Route25_Text_NobDefeat::
	.string "{JPN}いやあ みごとに\n"
	.string "やられちまったよ!$"

Route25_Text_NobPostBattle::
	.string "{JPN}あの ポケモンマニアは\n"
	.string "なまえに はじない ひとだよ。\p"
	.string "コレクションには めずらしい\n"
	.string "ポケモンが たくさん いるんだ。$"

Route25_Text_WayneIntro::
	.string "{JPN}マサキに あいに いくのか?\n"
	.string "まずは しょうぶだ!$"

Route25_Text_WayneDefeat::
	.string "{JPN}たいした もんだ。$"

Route25_Text_WaynePostBattle::
	.string "{JPN}したの みちは ハナダシティへの\n"
	.string "ちかみちだぞ。$"

Route25_Text_SeaCottageSign::
	.string "{JPN}みさきのこや\n"
	.string "マサキの いえ!$"

Route25_Text_MistyHighHopesAboutThisPlace::
	.string "{JPN}この みさきは ゆうめいな デートスポット。\p"
	.string "ジムリーダーの カスミも この ばしょに\n"
	.string "あこがれて いるらしい。$"

Route25_Text_AreYouHereAlone::
	.string "{JPN}こんにちは ひとりで きたの?\p"
	.string "ハナダの みさきに くるなら……\n"
	.string "やっぱり カップルで こないとね。$"

