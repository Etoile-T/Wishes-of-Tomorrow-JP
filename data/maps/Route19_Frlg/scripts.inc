Route19_Text_AlicePostBattle::
	.string "{JPN}かれしが ふたごじままで\n"
	.string "およぎたいって いったの。$"

Route19_Text_AxleIntro::
	.string "{JPN}おーい そこの!\n"
	.string "この うみは きけんだぞ!$"

Route19_Text_AxleDefeat::
	.string "{JPN}うおっ!\n"
	.string "あぶねえ!$"

Route19_Text_AxlePostBattle::
