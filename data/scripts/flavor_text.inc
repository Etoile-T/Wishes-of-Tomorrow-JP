@ Flavor text for interacting with various background objects

Text_Bookshelf::
	.string "{JPN}ポケモンの ほんが\n"
	.string "ぎっしり つまっている。$"

Text_NothingButPokemonBooks::
	.string "{JPN}ほんだなに ならんでいるのは\n"
	.string "ポケモンの ほん ばかりだ$"

Text_ATownMap::
	.string "{JPN}タウンマップだ。$"

