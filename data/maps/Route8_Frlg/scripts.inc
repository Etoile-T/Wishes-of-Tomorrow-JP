Route8_Frlg_MapScripts::
	.byte 0

Route8_EventScript_UndergroundPathSign::
	msgbox Route8_Text_UndergroundPathSign, MSGBOX_SIGN
	end

Route8_Text_AidanIntro::
	.string "{JPN}ポケモンは とくい みたいだけど\n"
	.string "かがくの せいせきは どうかな?$"

Route8_Text_AidanDefeat::
	.string "{JPN}いてっ!\n"
	.string "メルトダウンだ!$"

Route8_Text_AidanPostBattle::
	.string "{JPN}がっこうの ほうが まだ とくいなんだ!$"

Route8_Text_StanIntro::
	.string "{JPN}よーし!\n"
	.string "ゲームを しようぜ!$"

Route8_Text_StanDefeat::
	.string "{JPN}ちぇっ!\n"
	.string "あと すこし たりなかった!$"

Route8_Text_StanPostBattle::
	.string "{JPN}きょうは うまく いかなかったな。$"

Route8_Text_GlennIntro::
	.string "{JPN}おしえて あげよう。\n"
	.string "かつには さくせんが ひつようだ!$"

Route8_Text_GlennDefeat::
	.string "{JPN}ろんりてきじゃ ない!$"

Route8_Text_GlennPostBattle::
	.string "{JPN}さいしょは ベトベターで…それから…\n"
	.string "…それから…つぎは…$"

Route8_Text_PaigeIntro::
	.string "{JPN}ニドランが すきだから あつめてるの!$"

Route8_Text_PaigeDefeat::
	.string "{JPN}なんで?\n"
	.string "なんでなの??$"

Route8_Text_PaigePostBattle::
	.string "{JPN}ポケモンって おおきくなると\n"
	.string "かわいくなくなる! しんかは だめ!$"

Route8_Text_LeslieIntro::
	.string "{JPN}がっこうも ポケモンも たのしいわ。$"

Route8_Text_LeslieDefeat::
	.string "{JPN}あなたの おかげで よく わかったわ。\n"
	.string "わたしは べんきょう ひとすじね。$"

Route8_Text_LesliePostBattle::
	.string "{JPN}たまには そとの くうきを\n"
	.string "すおうと おもった んだけど…\p"
	.string "ヤマブキの ゲートの せいで\n"
	.string "ここから うごけないの。$"

Route8_Text_AndreaIntro::
	.string "{JPN}ニャースって かわいいの ニャー ニャー\n"
	.string "ニャー!$"

Route8_Text_AndreaDefeat::
	.string "{JPN}ニャーーーオ!$"

Route8_Text_AndreaPostBattle::
	.string "{JPN}ポッポや コラッタも\n"
	.string "かわいいと おもうの!$"

Route8_Text_MeganIntro::
	.string "{JPN}こんなふうに つったってるなんて\n"
	.string "まぬけに みえる でしょうね。$"

Route8_Text_MeganDefeat::
	.string "{JPN}わたしの かわいい ポケモンに\n"
	.string "なんてことを!$"

Route8_Text_MeganPostBattle::
	.string "{JPN}ヤマブキの もんばんが\n"
	.string "とおして くれないの。\p"
	.string "しごと なのは わかるけど\n"
	.string "いじわるだと おもうわ。$"

Route8_Text_RichIntro::
	.string "{JPN}おれは さすらいの ゲームずきさ!$"

Route8_Text_RichDefeat::
	.string "{JPN}だいチャンスを のがした!$"

Route8_Text_RichPostBattle::
	.string "{JPN}ゲームと ポケモンは ピーナッツと\n"
	.string "おなじ! やめられない とまらない!$"

Route8_Text_JuliaIntro::
	.string "{JPN}かわいくて まるくて ふわふわの\n"
	.string "ポケモンは なーんだ?$"

Route8_Text_JuliaDefeat::
	.string "{JPN}やめて!\p"
	.string "わたしの ピッピに ひどいこと しないで!$"

Route8_Text_JuliaPostBattle::
	.string "{JPN}ピッピは つきのいしを あてると\n"
	.string "しんか するって よんだの。\p"
	.string "ポケモンの ざっしで よんだのよ。\n"
	.string "ほんとう なのかしら?$"

Route8_Text_UndergroundPathSign::
	.string "{JPN}ちかつうろ\n"
	.string "タマムシシティ - シオンタウン$"

Route8_Text_EliIntro::
	.string "{JPN}エリ: ふたごパワーは すごいのよ。\n"
	.string "しってた?$"

Route8_Text_EliDefeat::
	.string "{JPN}エリ: でも…\n"
	.string "ふたごパワーを つかったのに…$"

Route8_Text_EliPostBattle::
	.string "{JPN}エリ: わたしは アンと いっしょに\n"
	.string "ポケモンを つかまえたの!$"

Route8_Text_EliNotEnoughMons::
	.string "{JPN}エリ: ポケモンが 2ひき いないと\n"
	.string "しょうぶ できないわ。$"

Route8_Text_AnneIntro::
	.string "{JPN}アン: ふたごパワーで\n"
	.string "びっくり させちゃうわよ!$"

Route8_Text_AnneDefeat::
	.string "{JPN}アン: わたしたちの ふたごパワーが…$"

Route8_Text_AnnePostBattle::
	.string "{JPN}アン: わたしは エリと いっしょに\n"
	.string "ポケモンを そだててるの。$"

Route8_Text_AnneNotEnoughMons::
	.string "{JPN}アン: ハーイ! しょうぶ しましょ!\n"
	.string "でも ポケモンは 2ひき つれてきてね。$"

Route8_Text_RicardoIntro::
	.string "{JPN}じてんしゃの ちょうしが わるいんだよ。$"

Route8_Text_RicardoDefeat::
	.string "{JPN}あーあ。\n"
	.string "やるき でねえな。$"

Route8_Text_RicardoPostBattle::
	.string "{JPN}スポークに くさが\n"
	.string "からまっちまってさ。$"

Route8_Text_JarenIntro::
	.string "{JPN}どけよ! じゃないと\n"
	.string "ひいちまうぞ!$"

Route8_Text_JarenDefeat::
	.string "{JPN}マジかよ おまえ?$"

Route8_Text_JarenPostBattle::
	.string "{JPN}これくらいで じぶんが とくべつだ\n"
	.string "なんて おもうんじゃ ねえぞ。$"
