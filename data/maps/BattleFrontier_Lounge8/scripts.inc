BattleFrontier_Lounge8_Text_WhatATrainerNeeds:
	.string "{JPN}トレーナーに ひつようなもの……\p"
	.string "ちしき……\n"
	.string "さくせん……\l"
	.string "うん……\l"
	.string "こんじょう……\l"
	.string "きりょく……\l"
	.string "ゆうき……\l"
	.string "そして じつりょく……\p"
	.string "よし ぜんぶ そろってるぞ!\n"
	.string "どの しせつでも むてき だな!\p"
	.string "え? ポケモン?\n"
	.string "なに それ?$"

BattleFrontier_Lounge8_Text_KnowAboutFrontierBrains:
	.string "{JPN}フロンティアブレーンって\n"
	.string "しってる?\p"
	.string "エニシダさんが そう よんでいる\n"
	.string "バトルフロンティアの 7つの しせつを\l"
	.string "しきる 7にんの とくべつな トレーナーさ。$"

BattleFrontier_Lounge8_Text_ToldMeIHaveTalentForBattling:
	.string "{JPN}バトルタワーで おねえさんに\n"
	.string "バトルの さいのうが あるって\l"
	.string "いわれたの!\p"
	.string "でも ポケモンコンテストの ほうが すきなの!\p"
	.string "なのに コンテストは にがて なの!\p"
	.string "さいのうが あるのと すきなのって\n"
	.string "おなじ じゃ ないんだね。$"

