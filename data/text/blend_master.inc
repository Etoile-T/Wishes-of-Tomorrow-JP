BerryBlender_Text_BlendWithTheBlendMaster:
	.string "{JPN}ブレンドマスター: いかにも!\n"
	.string "わたしこそが ブレンドマスター!\p"
	.string "わたしと まぜれば ブレンドの\n"
	.string "ごくいを その めで みられるぞ!$"

BerryBlender_Text_SeeMyMasteryInAction:
	.string "{JPN}ブレンドマスター: ふむ! わたしの\n"
	.string "わざを みたいと いうのだな?$"

BerryBlender_Text_TooBusyNowIsee:
	.string "{JPN}ふむ!\p"
	.string "なるほど いまは いそがしいのだな!\p"
	.string "だが しんぱい むよう!\n"
	.string "わたしは いちにちじゅう ここに いる!\l"
	.string "ようじを すませて はやく もどってこい!$"

BerryBlender_Text_BlendMasterNoBerries:
	.string "{JPN}ふむ!\p"
	.string "きのみを ひとつも もっておらんな!\p"
	.string "わたしは いちにちじゅう ここに いる!\n"
	.string "きのみを もって はやく もどってこい!$"

BerryBlender_Text_BlendMasterKnowHowToMakePokeblocks:
	.string "{JPN}もちろん!\n"
	.string "もちろんだとも!\p"
	.string "ところで…\n"
	.string "きのみから ポロックを つくる\l"
	.string "やりかたは しっているかね?$"

BerryBlender_Text_BlendMasterExplainBerryBlending:
	.string "{JPN}ふむ!\p"
	.string "なに かんたんな ことだ!\p"
	.string "ブレンダーの やじるしが じぶんの\n"
	.string "マークに きたら Aボタンを おすだけ。\p"
	.string "やることは それだけだ。\p"
	.string "わたしが Aボタンを おす せいかくさを\n"
	.string "みれば きっと わかるだろう。$"

BerryBlender_Text_BlendMasterLetsBerryBlender:
	.string "{JPN}よし!\p"
	.string "では はじめるとしよう!\p"
	.string "ブレンドマスターと いっしょに\n"
	.string "きのみブレンダー スタート!$"

BerryBlender_Text_BlendMasterNoPokeblockCase:
	.string "{JPN}ふむ!\p"
	.string "どうやら ポロックケースを\n"
	.string "まだ もっておらんようだな!\p"
	.string "わたしは いちにちじゅう ここに いる!\n"
	.string "ポロックケースを てにいれて もどってこい!$"

BerryBlender_Text_BlendMasterPokeblockCaseFull:
	.string "{JPN}ふむ!\p"
	.string "ポロックケースが いっぱいのようだな!\p"
	.string "わたしは いちにちじゅう ここに いる!\n"
	.string "ポロックを つかって もどってこい!$"

BerryBlender_Text_WhoaAwesome:
	.string "{JPN}うわあ!\n"
	.string "すっげえ!$"

BerryBlender_Text_WickedlyFast:
	.string "{JPN}めちゃくちゃ はやい!$"

BerryBlender_Text_WhatAnExpert:
	.string "{JPN}さすが たつじん!$"

BerryBlender_Text_MadeAmazingPokeblocksWithMaster:
	.string "{JPN}マスターと いっしょに まぜたら\n"
	.string "すごい ポロックが できたよ!$"

BerryBlender_Text_QualitiesOfBlendMaster:
	.string "{JPN}やじるしを きかいのように\n"
	.string "するどく おいかける め…\p"
	.string "とけいじかけのような せいかくさで\n"
	.string "Aボタンを たたく て…\p"
	.string "それらを そなえてこそ\n"
	.string "しんの ブレンドマスターなのだ。$"

BerryBlender_Text_MasterWorksOnSkillsInMountains:
	.string "{JPN}ブレンドマスターは ふだん やまおくで\n"
	.string "うでを みがいている らしいよ。\p"
	.string "ときどき ミナモに やってきて\n"
	.string "いちにちじゅう きのみを まぜてるんだ。$"
